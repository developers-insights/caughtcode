NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://ktmbtpuhqqofdkisqseq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=ktmbtpuhqqofdkisqseq
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ENCRYPTION_KEY=
WORKER_SECRET=
CRON_SECRET=
# Directorio donde el worker guarda el código bajado mientras dura una corrida
# (ver src/server/ingest/workspace.ts). En local, dejar vacío alcanza: cae al
# default relativo a process.cwd(). En el worker de Railway, ver
# docs/DEPLOY-RAILWAY.md para el valor recomendado.
CAUGHTCODE_STORAGE_DIR=
# Cuántos trabajos corre el worker en simultáneo (scripts/worker.ts, lee esto
# directo de process.env — default 2 si se deja vacío). En local, dejar vacío
# alcanza. En Railway está en 1 (ver docs/DEPLOY-RAILWAY.md): con concurrencia
# 1 el peor caso de memoria (worker + un Chromium) entra cómodo.
WORKER_CONCURRENCY=

# Resto de las perillas del worker. Todas tienen default razonable y no hace
# falta tocarlas: se documentan porque el código las lee y hasta ahora no
# figuraban en ningún lado, así que no había forma de saber que existían.
#   WORKER_KINDS              qué tipos de trabajo toma, separados por coma.
#                             Vacío = todos. Sirve para dedicar un worker a
#                             una sola cosa (ej. solo video).
#   WORKER_LEASE_SECONDS      cuánto tiempo se reserva un trabajo antes de que
#                             otro worker lo pueda reclamar (default 90).
#   WORKER_POLL_MS            cada cuánto le pregunta a la cola si hay algo.
#   WORKER_REQUEUE_MS         cada cuánto devuelve a la fila lo que venció.
#   WORKER_SHUTDOWN_GRACE_MS  cuánto espera a que terminen los trabajos en
#                             curso cuando le llega SIGTERM (Railway lo manda
#                             en cada redeploy).
#   WORKER_ID                 nombre de este worker en los logs. Por defecto
#                             se genera uno.
WORKER_KINDS=
WORKER_LEASE_SECONDS=
WORKER_POLL_MS=
WORKER_REQUEUE_MS=
WORKER_SHUTDOWN_GRACE_MS=
WORKER_ID=

# Rutas a herramientas externas. Vacío = se resuelven solas (las gramáticas
# desde el paquete instalado, ffmpeg desde `ffmpeg-static`). Solo se completan
# si hace falta apuntar a una copia propia.
CAUGHTCODE_GRAMMAR_DIR=
FFMPEG_PATH=

TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=es-AR-TomasNeural
VIDEO_RENDERER=web
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AUDIT=
STRIPE_PRICE_MONITORING=
GOOGLE_TTS_API_KEY=
